# Copy to .env and fill in. All settings are optional except the secret key in production.
CLINIC_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLINIC_COOKIE_SECURE=true
# CLINIC_DATABASE_URL=sqlite:////data/clinic.db
# Encrypt backup files at rest (NFR-04). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLINIC_BACKUP_ENCRYPTION_KEY=
# Off-server backup copy (mounted NAS / synced folder) — SET-01
CLINIC_OFFSITE_BACKUP_DIR=
CLINIC_BACKUP_HOUR=2
